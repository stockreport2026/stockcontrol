generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  currency   String   @default("KES")
  timezone   String   @default("Africa/Nairobi")
  createdAt  DateTime @default(now())
  branches   Branch[]
  users      User[]
  stockItems StockItem[]
}

model Branch {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  code               String
  location           String?
  status             String   @default("ACTIVE")
  sellingDays        Int      @default(26)
  createdAt          DateTime @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff              Staff[]
  staffSales         StaffSales[]
  branchSales        BranchSales[]
  creditSales        CreditSale[]
  repayments         Repayment[]
  stockTxs           StockTransaction[]
  stocktakes         Stocktake[]
  attendances        Attendance[]
  accountBalances    AccountBalance[]
  stockPositions     StockPosition[]
  stockVarianceItems StockVarianceItem[]
  reportDrafts       ReportDraft[]
  @@unique([organizationId, code])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String
  role           Role     @default(STOCK_CONTROLLER)
  branchIds      String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STOCK_CONTROLLER
  BRANCH_MANAGER
  ACCOUNTANT
}

model Staff {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  firstName      String
  lastName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  branch         Branch   @relation(fields: [branchId], references: [id])
  sales          StaffSales[]
  creditSales    CreditSale[]
  repayments     Repayment[]
  attendances    Attendance[]
}

model StaffSales {
  id              String   @id @default(cuid())
  branchId        String
  staffId         String
  periodYear      Int
  periodMonth     Int
  periodStartDate DateTime
  periodEndDate   DateTime
  actualSales     Decimal  @db.Decimal(18, 2)
  systemSales     Decimal  @db.Decimal(18, 2)
  variance        Decimal  @db.Decimal(18, 2) @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@unique([staffId, periodYear, periodMonth])
  @@index([branchId, periodYear, periodMonth])
}

model BranchSales {
  id              String   @id @default(cuid())
  branchId        String
  periodYear      Int
  periodMonth     Int
  periodStartDate DateTime
  periodEndDate   DateTime
  actualSales     Decimal  @db.Decimal(18, 2)
  systemSales     Decimal  @db.Decimal(18, 2)
  variance        Decimal  @db.Decimal(18, 2) @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

model CreditSale {
  id           String   @id @default(cuid())
  branchId     String
  staffId      String
  customerName String
  saleDate     DateTime
  amount       Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff        Staff    @relation(fields: [staffId], references: [id])
  @@index([branchId, saleDate])
  @@index([staffId, saleDate])
}

model Repayment {
  id           String   @id @default(cuid())
  branchId     String
  staffId      String
  customerName String?
  paymentDate  DateTime
  amount       Decimal  @db.Decimal(18, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff        Staff    @relation(fields: [staffId], references: [id])
  @@index([branchId, paymentDate])
  @@index([staffId, paymentDate])
  @@index([customerName])
}

model Attendance {
  id              String   @id @default(cuid())
  staffId         String
  branchId        String
  periodStartDate DateTime
  periodEndDate   DateTime
  daysWorked      Int      @default(0)
  leaveDays       Int      @default(0)
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [branchId], references: [id])
  @@index([staffId, periodStartDate])
  @@index([branchId, periodStartDate])
}

model StockPosition {
  id                String   @id @default(cuid())
  branchId          String
  periodStartDate   DateTime
  periodEndDate     DateTime
  openingStockValue Decimal  @db.Decimal(18, 2)
  closingStockValue Decimal  @db.Decimal(18, 2)
  variance          Decimal  @db.Decimal(18, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId, periodStartDate])
  @@index([periodStartDate, periodEndDate])
}

model StockVarianceItem {
  id              String   @id @default(cuid())
  branchId        String
  periodStartDate DateTime
  periodEndDate   DateTime
  itemName        String
  expectedQty     Decimal  @db.Decimal(18, 2)
  actualQty       Decimal  @db.Decimal(18, 2)
  varianceQty     Decimal  @db.Decimal(18, 2)
  unitCost        Decimal  @db.Decimal(18, 2)
  varianceValue   Decimal  @db.Decimal(18, 2)
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@index([branchId, periodStartDate])
}

model StockItem {
  id             String   @id @default(cuid())
  organizationId String
  description    String
  category       String?
  unit           String   @default("pcs")
  unitCost       Decimal  @db.Decimal(18, 2) @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   StockTransaction[]
  stocktakeItems StocktakeItem[]
  @@unique([organizationId, description])
}

model StockTransaction {
  id              String   @id @default(cuid())
  stockItemId     String
  branchId        String
  transactionDate DateTime
  type            StockTxType
  quantity        Decimal  @db.Decimal(18, 2)
  unitCost        Decimal  @db.Decimal(18, 2) @default(0)
  value           Decimal  @db.Decimal(18, 2) @default(0)
  reference       String?
  notes           String?
  createdAt       DateTime @default(now())
  stockItem       StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [branchId], references: [id])
  @@index([branchId, transactionDate])
  @@index([stockItemId, transactionDate])
}

enum StockTxType {
  OPENING
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  SALE
  RETURN
  ADJUSTMENT
}

model Stocktake {
  id            String   @id @default(cuid())
  branchId      String
  stocktakeDate DateTime
  status        RecordStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime @default(now())
  branch        Branch   @relation(fields: [branchId], references: [id])
  items         StocktakeItem[]
  @@index([branchId, stocktakeDate])
}

model StocktakeItem {
  id            String   @id @default(cuid())
  stocktakeId   String
  stockItemId   String
  expectedQty   Decimal  @db.Decimal(18, 2)
  actualQty     Decimal  @db.Decimal(18, 2)
  varianceQty   Decimal  @db.Decimal(18, 2)
  unitCost      Decimal  @db.Decimal(18, 2)
  varianceValue Decimal  @db.Decimal(18, 2)
  notes         String?
  stocktake     Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  stockItem     StockItem @relation(fields: [stockItemId], references: [id])
  @@unique([stocktakeId, stockItemId])
}

enum RecordStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model AccountBalance {
  id                String   @id @default(cuid())
  branchId          String
  periodYear        Int
  periodMonth       Int
  periodStartDate   DateTime
  periodEndDate     DateTime
  openingBalance    Decimal  @db.Decimal(18, 2) @default(0)
  closingBalance    Decimal  @db.Decimal(18, 2) @default(0)
  additionalInfo    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, periodYear, periodMonth])
}

model ReportDraft {
  id          String   @id @default(cuid())
  branchId    String
  periodYear  Int
  periodMonth Int
  notes       String?  @db.Text
  adjustments String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, periodYear, periodMonth])
}
